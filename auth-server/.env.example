# Google Cloud Console > OAuth 2.0 Client ID > Web application
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# GitHub Pages origin only. No path or trailing slash.
WEBSITE_ORIGINS=https://cnrcftc.github.io

# Generate a 32-byte (64 hex character) signing key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_KEY=PASTE_64_HEX_CHARACTERS_HERE

PORT=3000

# Use 1 when deployed behind one trusted reverse proxy. Set 0 for direct local hosting.
TRUST_PROXY=1
